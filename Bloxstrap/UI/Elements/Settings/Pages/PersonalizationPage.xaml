<ui:UiPage x:Class="Bloxstrap.UI.Elements.Settings.Pages.PersonalizationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:Bloxstrap.UI.Elements.Controls"
      xmlns:dmodels="clr-namespace:Bloxstrap.UI.ViewModels.Settings"
      mc:Ignorable="d"
      d:DesignHeight="900" d:DesignWidth="800"
      d:DataContext="{d:DesignInstance dmodels:PersonalizationViewModel, IsDesignTimeCreatable=True}"
      Title="PersonalizationPage"
      Scrollable="True">
    <StackPanel Margin="0,0,14,14">
        <TextBlock Text="Cambiá el color de acento de toda la app y elegí si querés la imagen animada de fondo."
                   FontSize="14" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,10" />

        <TextBlock Text="Color de acento" FontSize="18" FontWeight="Medium" />
        <TextBlock Text="Se aplica al instante en todas las ventanas abiertas." TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8" />

        <ListBox ItemsSource="{Binding Accents, Mode=OneTime}"
                 SelectedItem="{Binding SelectedAccent, Mode=TwoWay}"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Margin" Value="0,0,6,6" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="SwatchRoot" CornerRadius="7" Padding="8,4"
                                        BorderThickness="2" BorderBrush="Transparent"
                                        Background="{DynamicResource ControlFillColorDefaultBrush}">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="SwatchRoot" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="SwatchRoot" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="16" Height="16" CornerRadius="8"
                                Background="{Binding Brush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Name}" Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Text="Color personalizado" FontSize="18" FontWeight="Medium" Margin="0,10,0,0" />
        <TextBlock Text="Cualquier color en hexadecimal. El circulito de arriba se marca solo si coincide con un preset."
                   TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8" />

        <Grid MaxWidth="420" HorizontalAlignment="Left">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBox Grid.Column="0" PlaceholderText="#FF1336" Text="{Binding CustomAccentHex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <ui:Button Grid.Column="1" Margin="8,0,0,0" Content="Aplicar" Appearance="Primary"
                       Command="{Binding ApplyCustomAccentCommand, Mode=OneTime}" />
        </Grid>

        <TextBlock Text="{Binding CustomAccentStatus, Mode=OneWay}" Margin="0,6,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <TextBlock Text="Fondo" FontSize="18" FontWeight="Medium" Margin="0,16,0,0" />

        <controls:OptionControl Header="Mostrar la imagen de fondo"
                                Description="La imagen de VidoyStrap detrás del contenido de las ventanas. El nombre VidoyStrap queda visible igual.">
            <ui:ToggleSwitch IsChecked="{Binding ShowBackdrop, Mode=TwoWay}" />
        </controls:OptionControl>

        <controls:OptionControl Header="Animar el GIF"
                                Description="Reproduce el GIF animado como fondo. Si lo apagás queda el primer cuadro, quieto.">
            <ui:ToggleSwitch IsChecked="{Binding AnimateBackdrop, Mode=TwoWay}" IsEnabled="{Binding AnimateBackdropEnabled, Mode=OneWay}" />
        </controls:OptionControl>
    </StackPanel>
</ui:UiPage>
